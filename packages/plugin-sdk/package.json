{
  "name": "@talekiln/plugin-sdk",
  "version": "0.1.0",
  "description": "Talekiln provider-adapter plugin SDK: manifest schema, adapter interface, runtime validation, contract test kit (MIT)",
  "license": "MIT",
  "private": true,
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./contract": "./src/contract.js",
    "./bridge": "./src/bridge.js",
    "./signing": "./src/signing.js"
  },
  "bin": { "talekiln-sign-plugin": "scripts/sign-plugin.mjs" },
  "files": ["src", "scripts", "examples", "LICENSE", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sign": "node scripts/sign-plugin.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
