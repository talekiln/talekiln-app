generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Account {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  disabledAt   DateTime?
  plan         String         @default("test")
  createdAt    DateTime       @default(now())
  devices      Device[]
  refreshTokens RefreshToken[]
  invitesUsed  InviteCode[]   @relation("InviteUsedBy")
}

model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  plan        String    @default("test")
  createdBy   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  usedBy      Account?  @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
}

model Device {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fingerprint String
  name        String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  @@unique([accountId, fingerprint])
  @@index([accountId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  familyId  String
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId  String?
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([familyId])
  @@index([accountId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// 匿名统计事件：不含账号、IP、提示词内容或密钥。installId 为客户端随机生成的匿名标识。
model TelemetryEvent {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  day       String
  installId String
  name      String
  code      String?
  step      String?

  @@index([day, name])
}

model Feedback {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  accountId      String?
  installId      String?
  contact        String?
  message        String
  taskId         String?
  appVersion     String?
  diagnostic     Bytes?
  diagnosticSize Int      @default(0)

  @@index([createdAt])
}

model ReferralClick {
  id        String   @id @default(uuid())
  code      String
  src       String?
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}
