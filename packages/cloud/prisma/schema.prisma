generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Account {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  disabledAt    DateTime?
  plan          String         @default("test")
  createdAt     DateTime       @default(now())
  // P2-C：手机号（短信登录）与微信 openid（扫码登录），都可空且唯一
  phone         String?        @unique
  wechatOpenId  String?        @unique
  devices       Device[]
  refreshTokens RefreshToken[]
  invitesUsed   InviteCode[]   @relation("InviteUsedBy")
  subscription  Subscription?
  orders        Order[]
  licenceUsages LicenceUsage[]
  adminRole     AdminRole?
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  plan      String    @default("test")
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedAt    DateTime?
  usedById  String?
  revokedAt DateTime?
  usedBy    Account?  @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
}

model Device {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fingerprint String
  name        String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  @@unique([accountId, fingerprint])
  @@index([accountId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  familyId  String
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId  String?
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([familyId])
  @@index([accountId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// 匿名统计事件：不含账号、IP、提示词内容或密钥。installId 为客户端随机生成的匿名标识。
model TelemetryEvent {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  day       String
  installId String
  name      String
  code      String?
  step      String?

  @@index([day, name])
}

model Feedback {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  accountId      String?
  installId      String?
  contact        String?
  message        String
  taskId         String?
  appVersion     String?
  diagnostic     Bytes?
  diagnosticSize Int      @default(0)

  @@index([createdAt])
}

model ReferralClick {
  id        String   @id @default(uuid())
  code      String
  src       String?
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}

// ---------------------------------------------------------------------------
// 收费与授权（P2-B）。金额一律为整数分（CNY）。价格与权益放在 PlanVersion，
// 改价 = 新增一个版本；已下的订单永远指向下单时的版本。
// ---------------------------------------------------------------------------

enum BillingPeriod {
  MONTH
  YEAR
}

enum OrderStatus {
  PENDING
  PAID
  CLOSED
  REFUNDING
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InvoiceStatus {
  REQUESTED
  ISSUED
  VOID
}

model Plan {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  versions  PlanVersion[]
}

model PlanVersion {
  id              String         @id @default(uuid())
  planId          String
  plan            Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  version         Int
  priceMonthCents Int?
  priceYearCents  Int?
  // { maxDevices, exportMaxHeight, watermark, features: string[] }
  entitlements    Json
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
  orders          Order[]

  @@unique([planId, version])
}

// 每个账号至多一条订阅；currentPeriodEnd 即授权到期时间，是否有效按当前时间判断。
model Subscription {
  id                 String      @id @default(uuid())
  accountId          String      @unique
  account            Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planVersionId      String
  planVersion        PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Order {
  id            String        @id @default(uuid())
  outTradeNo    String        @unique
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  planVersionId String
  planVersion   PlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  period        BillingPeriod
  amountCents   Int
  provider      String
  status        OrderStatus   @default(PENDING)
  codeUrl       String?
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  paidAt        DateTime?
  // 付款成功时确定：本单授予的授权区间（退款折算依据）
  periodStart   DateTime?
  periodEnd     DateTime?
  payment       Payment?
  refunds       Refund[]
  invoice       Invoice?

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  tradeNo     String
  amountCents Int
  paidAt      DateTime
  createdAt   DateTime @default(now())

  @@unique([provider, tradeNo])
}

model Refund {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  outRefundNo      String       @unique
  amountCents      Int
  status           RefundStatus @default(PENDING)
  reason           String?
  providerRefundNo String?
  failureReason    String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  finishedAt       DateTime?

  @@index([orderId])
  @@index([createdAt])
}

model Invoice {
  id          String        @id @default(uuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  title       String
  taxNo       String?
  email       String
  amountCents Int
  status      InvoiceStatus @default(REQUESTED)
  invoiceNo   String?
  createdAt   DateTime      @default(now())
  issuedAt    DateTime?
  voidedAt    DateTime?

  @@index([status, createdAt])
}

// 回调去重：(provider, notifyId) 唯一；与订单生效在同一事务里写入。
model PaymentNotification {
  id         String   @id @default(uuid())
  provider   String
  notifyId   String
  outTradeNo String
  receivedAt DateTime @default(now())

  @@unique([provider, notifyId])
  @@index([outTradeNo])
}

// 每次签发许可证令牌记一条（用量与审计）。
model LicenceUsage {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId  String
  planCode  String
  issuedAt  DateTime
  expiresAt DateTime

  @@index([accountId, issuedAt])
}

// ---- P2-H：公告、版本灰度、管理员角色、审计 ----
// 枚举类字段用 String 存，取值由服务层 zod 与迁移里的 CHECK 约束共同保证。

model Announcement {
  id        String    @id @default(uuid())
  title     String
  body      String
  level     String    @default("info") // info | warn | critical
  channel   String    @default("all") // all | beta | stable
  startsAt  DateTime
  endsAt    DateTime?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled, startsAt])
}

model Release {
  id             String   @id @default(uuid())
  version        String
  channel        String // beta | stable
  rolloutPercent Int      @default(0)
  minVersion     String?
  forced         Boolean  @default(false)
  notes          String   @default("")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([version, channel])
  @@index([channel, enabled])
}

// 后台角色：每账号至多一条；无此记录时，Account.role = ADMIN 的旧管理员按 ADMIN 对待。
model AdminRole {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String // ADMIN | OPERATOR | READONLY
  grantedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 审计日志：只增不改。操作者账号被删后保留邮箱快照。
model AdminAudit {
  id         String   @id @default(uuid())
  at         DateTime
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  ok         Boolean
  status     Int
  detail     Json?
  ip         String?

  @@index([at])
  @@index([actorId, at])
  @@index([targetType, targetId])
}

// P3-T 模板市场：模板（id 即清单里的 id）与它的版本（清单 JSON + 官方 ES256 签名）。只有 published 的版本进公开目录。
model Template {
  id          String            @id
  name        String
  genre       String
  tier        String            @default("free") // free | pro
  description String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    TemplateVersion[]
}

model TemplateVersion {
  id          String    @id @default(uuid())
  templateId  String
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  manifest    Json
  packageUrl  String?
  sha256      String
  signature   String
  kid         String
  tier        String    @default("free") // free | pro
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([templateId, version])
  @@index([published, publishedAt])
}
// ---- P3-P：插件注册表（登记、版本、审核、官方签名） ----
// 云端不保存插件包本身：只记 manifest、每个文件的 sha256、包的下载地址与包哈希。
// 签名覆盖 canonicalJson({ manifest, files }) —— 与 @talekiln/plugin-sdk verifySignature 的算法一致。

model Plugin {
  id        String          @id @default(uuid())
  name      String          @unique // manifest.name，即本地的服务商 id
  label     String
  homepage  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  PluginVersion[]
}

model PluginVersion {
  id           String         @id @default(uuid())
  pluginId     String
  plugin       Plugin         @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  version      String
  manifest     Json // 提交时的 manifest（含 files，不含 signature）
  fileHashes   Json // { "<相对路径>": "<sha256 hex>" }
  hash         String // sha256(签名载荷)，与本地插件页展示的指纹一致
  packageUrl   String
  sha256       String // 插件包（zip）的 sha256
  signature    Json? // { alg, kid, value }，签名后才有
  signedAt     DateTime?
  signedBy     String?
  reviewStatus String         @default("pending") // pending | approved | rejected
  reviewedAt   DateTime?
  reviewedBy   String?
  submittedBy  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reviews      PluginReview[]

  @@unique([pluginId, version])
  @@index([reviewStatus, createdAt])
  @@index([hash])
}

// 审核记录：只增不改。
model PluginReview {
  id         String        @id @default(uuid())
  versionId  String
  version    PluginVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  action     String // submit | approve | reject | sign
  notes      String        @default("")
  actorId    String?
  actorEmail String?
  createdAt  DateTime      @default(now())

  @@index([versionId, createdAt])
}

// P2-C 登录：短信验证码（只存 HMAC，带过期与错误次数）与微信扫码票据（状态机 pending/scanned/confirmed/expired）。
model SmsCode {
  id         String    @id @default(uuid())
  phone      String
  scene      String    @default("login")
  codeHash   String
  attempts   Int       @default(0)
  createdAt  DateTime
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone, scene, createdAt])
}

model WechatQrTicket {
  ticket     String    @id
  status     String    @default("pending")
  openId     String?
  createdAt  DateTime
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
}
