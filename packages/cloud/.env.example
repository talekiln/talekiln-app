# 复制为 .env 并替换占位符；切勿提交真实密钥。
DATABASE_URL=postgresql://talekiln:CHANGE_ME@localhost:5432/talekiln
PORT=3000
NODE_ENV=development
# 访问令牌签名密钥（至少 32 字符随机串）
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+
# 许可证 ES256 私钥（PKCS8 PEM，换行写成 \n）。开发环境留空则每次启动临时生成。
LICENCE_PRIVATE_KEY_PEM=
LICENCE_KEY_ID=lic-1
LICENCE_TTL_DAYS=7
LICENCE_GRACE_DAYS=14
# 插件签名 ES256 私钥（PKCS8 PEM，换行写成 \n），与许可证密钥分开，只在服务器上生成和保管（见 docs/tencent-deploy.md 第 7 节）。
# 留空则暂用许可证密钥给插件签名（生产环境启动时会打印告警）。kid 不能与 LICENCE_KEY_ID 相同。
PLUGIN_SIGNING_PRIVATE_KEY_PEM=
PLUGIN_SIGNING_KEY_ID=plg-1
# 轮换后退役、但仍要留在 JWKS 里验旧签名的插件签名公钥（SPKI PEM，换行写成 \n）：多把用 ; 分隔，
# kid 用逗号分隔、按同样顺序一一对应。只放公钥，私钥退役后销毁。例：
# PLUGIN_SIGNING_RETIRED_PUBLIC_KEYS_PEM=<公钥1 PEM>;<公钥2 PEM>
# PLUGIN_SIGNING_RETIRED_KEY_IDS=plg-1,plg-2
PLUGIN_SIGNING_RETIRED_PUBLIC_KEYS_PEM=
PLUGIN_SIGNING_RETIRED_KEY_IDS=
# 首个管理员（仅在账号不存在时创建）。口令只通过环境变量/密钥管理注入，不要写进仓库
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 管理后台令牌密钥（至少 32 字符）。留空则由 JWT_ACCESS_SECRET 派生
ADMIN_JWT_SECRET=
# 诊断包大小上限（字节，解码后）、每 IP 每 10 分钟反馈条数
MAX_DIAGNOSTIC_BYTES=1500000
FEEDBACK_RATE_LIMIT=5
# 部署在反向代理之后时填代理层数（如 1），限流才使用真实客户端 IP
TRUST_PROXY=

# P2-C 登录适配器：mock = 模拟实现（短信验证码只写服务端日志，非生产环境接口还会回传 debug_code；
# 微信二维码靠 POST /auth/wechat/qr/:ticket/confirm 手动“模拟确认”），none = 未接入（相关接口 503）。
# 留空时开发 / 测试环境为 mock，生产环境为 none。真实厂商（阿里云短信、微信开放平台）尚未接入，
# 接入时在 src/login/ 下实现 SmsProvider / WechatQrProvider 并在 registry.ts 注册，见 docs/phase2-login.md。
SMS_PROVIDER=
WECHAT_PROVIDER=
# 以下为将来接真实厂商时的占位，当前代码不读取：
# ALIYUN_SMS_ACCESS_KEY_ID= / ALIYUN_SMS_ACCESS_KEY_SECRET= / ALIYUN_SMS_SIGN_NAME= / ALIYUN_SMS_TEMPLATE_CODE=
# WECHAT_OPEN_APP_ID= / WECHAT_OPEN_APP_SECRET= / WECHAT_OPEN_REDIRECT_URI=

# 目录（模型/价格/公告）JSON 文件路径，留空用内置示例
CATALOG_FILE=
# 推广跳转：{"bailian":"https://..."}；主机须在白名单内（默认已含三个平台主机）
REFERRAL_LINKS=
REFERRAL_ALLOWED_HOSTS=
# docker-compose 使用
POSTGRES_PASSWORD=CHANGE_ME

# 可选：自建 MinIO（docker-compose.minio.yml，P3-K 云备份 / 工作室版共享存储）。口令至少 8 位，只放这里
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Caddy 反代后的对外 S3 地址与控制台地址（可留空）
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=
# 大陆机房拉不到 Docker Hub 时换成镜像站地址
MINIO_IMAGE=

# P3-S 工作室版：新建工作室的默认席位数（计费占位：席位定价待定，后台可逐个调整）
STUDIO_DEFAULT_SEAT_LIMIT=3
