{
  "name": "talekiln",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @talekiln/desktop dev",
    "dev:web": "pnpm -r --parallel --filter @talekiln/local --filter @talekiln/renderer dev",
    "build": "pnpm --filter @talekiln/renderer build",
    "dist:win": "pnpm --filter @talekiln/desktop dist:win",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "licenses:check": "node scripts/licenses-check.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "test:scripts": "node --test scripts/open-source-export.test.mjs",
    "export:dry": "node scripts/open-source-export.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "prisma",
      "sharp",
      "vue-demi"
    ]
  }
}
